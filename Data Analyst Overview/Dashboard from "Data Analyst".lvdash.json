{
  "datasets": [
    {
      "name": "2063cfce",
      "displayName": "Booking Trends and Revenue Overview Dataset",
      "queryLines": [
        "SELECT check_in_date, city, total_bookings, confirmed_bookings,\n",
        "cancelled_bookings, pending_bookings, total_revenue, avg_nights\n",
        "FROM workspace.`03_gold`.gold_bookings\n",
        "ORDER  BY check_in_date\n",
        "LIMIT  10;\n",
        "\n"
      ],
      "columns": [
        {
          "displayName": "Total Revenue",
          "description": "",
          "expression": "SUM(total_revenue)"
        },
        {
          "displayName": "Total Bookings",
          "description": "",
          "expression": "SUM(total_bookings)"
        },
        {
          "displayName": "Confirmed Bookings",
          "description": "",
          "expression": "SUM(confirmed_bookings)"
        },
        {
          "displayName": "Average Revenue per Bookings",
          "description": "",
          "expression": "SUM(total_revenue)/SUM(total_bookings)"
        },
        {
          "displayName": "Total Cancelled Bookings",
          "description": "",
          "expression": "SUM(cancelled_bookings)"
        }
      ]
    },
    {
      "name": "e91fb214",
      "displayName": "Revenue by city",
      "queryLines": [
        "  SELECT city,\r\n",
        "         ROUND(SUM(total_revenue), 2)  AS revenue,\r\n",
        "         SUM(total_bookings)           AS bookings,\r\n",
        "         SUM(confirmed_bookings)       AS confirmed\r\n",
        "  FROM   workspace.`03_gold`.gold_bookings\r\n",
        "  GROUP  BY city\r\n",
        "  ORDER  BY revenue DESC;\r\n"
      ]
    },
    {
      "name": "758a0c4b",
      "displayName": "Revenue by Trend",
      "queryLines": [
        "\r\n",
        "  SELECT date_format(check_in_date, 'yyyy-MM')  AS month,\r\n",
        "         ROUND(SUM(total_revenue), 2)           AS revenue,\r\n",
        "         SUM(total_bookings)                    AS bookings\r\n",
        "  FROM   workspace.`03_gold`.gold_bookings\r\n",
        "  GROUP  BY 1\r\n",
        "  ORDER  BY 1;"
      ]
    },
    {
      "name": "9575d942",
      "displayName": "Booking Status mixed by city",
      "queryLines": [
        "  SELECT city,\r\n",
        "         SUM(confirmed_bookings)  AS confirmed,\r\n",
        "         SUM(completed_bookings)  AS completed,\r\n",
        "         SUM(pending_bookings)    AS pending,\r\n",
        "         SUM(cancelled_bookings)  AS cancelled\r\n",
        "  FROM   workspace.`03_gold`.gold_bookings\r\n",
        "  GROUP  BY city\r\n",
        "  ORDER  BY confirmed DESC;"
      ]
    },
    {
      "name": "8f627b4e",
      "displayName": "Operational KPIs by city",
      "queryLines": [
        "  SELECT city,\r\n",
        "         SUM(total_nights)                         AS total_nights,\r\n",
        "         ROUND(AVG(avg_nights), 2)                 AS avg_nights_per_booking,\r\n",
        "         SUM(total_guests)                         AS total_guests,\r\n",
        "         SUM(distinct_properties)                  AS property_days,\r\n",
        "         ROUND(AVG(avg_price_per_night), 2)        AS avg_price_per_night\r\n",
        "  FROM   workspace.`03_gold`.gold_bookings\r\n",
        "  GROUP  BY city\r\n",
        "  ORDER  BY total_nights DESC;"
      ]
    }
  ],
